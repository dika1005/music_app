# === Tambahan proyek MelodyFlow — jangan hapus bagian ini ===

# File lokal spesifik mesin (berisi path SDK komputer ini). Kalau ikut
# ter-commit, build di komputer lain bisa gagal / menimpa konfigurasi.
android/local.properties

# Kunci signing rilis — JANGAN PERNAH di-commit ke repo publik!
*.keystore
*.jks
key.properties
android/key.properties
android/app/key.properties

# Secret / kredensial
.env
*.env
google-services.json
GoogleService-Info.plist
*.pem
*.p12

# Hasil build (APK bisa >80 MB) — distribusikan lewat GitHub Releases,
# bukan lewat repo. Lihat tool/build-apks.sh dan tool/build-arm32.sh.
*.apk
*.aab
release_apks/
